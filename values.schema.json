{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "required": [
    "image",
    "ffmpeg",
    "shaka",
    "replicaCount",
    "resources",
    "storage",
    "health",
    "service",
    "cubemap",
    "ingress"
  ],
  "properties": {
    "replicaCount": {
      "description": "Only one pod-local HLS origin is supported.",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffmpeg", "packager", "nginx", "cubemap"],
      "properties": {
        "ffmpeg": { "$ref": "#/definitions/image" },
        "packager": { "$ref": "#/definitions/image" },
        "nginx": { "$ref": "#/definitions/image" },
        "cubemap": { "$ref": "#/definitions/image" }
      }
    },
    "ffmpeg": {
      "type": "object",
      "required": ["inputSourceUrl", "inputOptions", "encodingOptions"],
      "properties": {
        "inputSourceUrl": { "type": "string", "minLength": 1 },
        "inputOptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "number"] }
        },
        "encodingOptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "number"] }
        }
      }
    },
    "shaka": {
      "type": "object",
      "required": ["segmentDurationSeconds", "segmentRetentionMinutes", "arguments"],
      "properties": {
        "segmentDurationSeconds": { "type": "integer", "minimum": 1 },
        "segmentRetentionMinutes": { "type": "integer", "minimum": 6 },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": { "type": ["string", "number"] }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["sizeLimit"],
      "properties": {
        "sizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "health": {
      "type": "object",
      "required": ["mediaPlaylistPath", "maxAgeSeconds", "startupFailureThreshold", "failureThreshold"],
      "properties": {
        "mediaPlaylistPath": { "type": "string", "pattern": "^/stream/.+\\.m3u8$" },
        "maxAgeSeconds": { "type": "integer", "minimum": 10 },
        "startupFailureThreshold": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "cubemap": {
      "type": "object",
      "required": ["enabled", "udpPort", "httpPort", "loadBalancerIP", "inputMaxAgeSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "udpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "loadBalancerIP": { "type": "string", "minLength": 1 },
        "inputMaxAgeSeconds": { "type": "integer", "minimum": 10 }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "host", "pathPrefix", "entryPoints", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "pathPrefix": { "type": "string", "pattern": "^/.*\\/$" },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tls": {
          "type": "object",
          "required": ["enabled", "certResolver"],
          "properties": {
            "enabled": { "type": "boolean" },
            "certResolver": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "anyOf": [
        { "properties": { "tag": { "minLength": 1 } } },
        { "properties": { "digest": { "minLength": 1 } } }
      ]
    }
  }
}
