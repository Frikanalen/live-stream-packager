{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "required": [
    "image",
    "ffmpeg",
    "hls",
    "replicaCount",
    "resources",
    "storage",
    "health",
    "service",
    "cubemap",
    "ingress"
  ],
  "properties": {
    "replicaCount": {
      "description": "Origin pods. More than one needs highAvailability.stickyCookie so a viewer stays on one pod-local HLS origin.",
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ffmpeg",
        "nginx",
        "cubemap"
      ],
      "properties": {
        "ffmpeg": {
          "$ref": "#/definitions/image"
        },
        "nginx": {
          "$ref": "#/definitions/image"
        },
        "cubemap": {
          "$ref": "#/definitions/image"
        }
      }
    },
    "ffmpeg": {
      "type": "object",
      "required": [
        "inputSourceUrl",
        "inputOptions",
        "encodingOptions"
      ],
      "properties": {
        "inputSourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "inputOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "encodingOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "hls": {
      "type": "object",
      "required": [
        "segmentDurationSeconds",
        "listSize",
        "deleteThreshold"
      ],
      "properties": {
        "segmentDurationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "listSize": {
          "type": "integer",
          "minimum": 3
        },
        "deleteThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": [
        "sizeLimit"
      ],
      "properties": {
        "sizeLimit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "health": {
      "type": "object",
      "required": [
        "mediaPlaylistPaths",
        "maxAgeSeconds",
        "startupFailureThreshold",
        "failureThreshold"
      ],
      "properties": {
        "mediaPlaylistPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/stream/[^ ]+\\.m3u8$"
          }
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "maxSkewSeconds": {
          "type": "number",
          "minimum": 0
        },
        "maxLagSeconds": {
          "type": "number",
          "minimum": 10
        },
        "startupFailureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "priorityClass": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "description": {
          "type": "string"
        }
      }
    },
    "airlog": {
      "type": "object",
      "required": ["enabled", "segmentSeconds", "retentionDays", "uid", "video", "audio", "storage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "inputUrl": { "type": "string" },
        "segmentSeconds": { "type": "integer", "minimum": 2, "maximum": 60 },
        "retentionDays": { "type": "integer", "minimum": 1, "maximum": 31 },
        "uid": { "type": "integer", "minimum": 1 },
        "video": {
          "type": "object",
          "required": ["height", "fps", "bitrate"],
          "properties": {
            "height": { "type": "integer", "minimum": 144, "maximum": 1080 },
            "fps": { "type": "integer", "minimum": 1, "maximum": 50 },
            "bitrate": { "type": "string", "pattern": "^[0-9]+[kM]$" }
          }
        },
        "audio": {
          "type": "object",
          "required": ["bitrate", "channels"],
          "properties": {
            "bitrate": { "type": "string", "pattern": "^[0-9]+k$" },
            "channels": { "enum": [1, 2] }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "existingClaim": { "type": "string" },
            "nfs": {
              "type": "object",
              "properties": {
                "server": { "type": "string" },
                "path": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "cubemap": {
      "type": "object",
      "required": [
        "enabled",
        "hostNetwork",
        "multicastGroup",
        "udpPort",
        "httpPort",
        "loadBalancerIP",
        "inputMaxAgeSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostNetwork": {
          "type": "boolean"
        },
        "multicastGroup": {
          "type": "string"
        },
        "udpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "loadBalancerIP": {
          "type": "string",
          "minLength": 1
        },
        "inputMaxAgeSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "replicaCount": {
          "description": "Cubemap pods, at most one per node when highAvailability.spreadAcrossNodes.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "className",
        "host",
        "pathPrefix",
        "entryPoints",
        "tls"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "pathPrefix": {
          "type": "string",
          "pattern": "^/.*\\/$"
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "certResolver"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "certResolver": {
              "type": "string"
            }
          }
        }
      }
    },
    "highAvailability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spreadAcrossNodes": {
          "type": "boolean",
          "description": "One origin and one Cubemap per node; each origin reads its node's Cubemap."
        },
        "podDisruptionBudget": {
          "type": "boolean"
        },
        "stickyCookie": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled",
            "name"
          ]
        }
      },
      "required": [
        "spreadAcrossNodes",
        "podDisruptionBudget",
        "stickyCookie"
      ]
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "tag": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "digest": {
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "replicaCount": {
            "minimum": 2
          }
        },
        "required": [
          "replicaCount"
        ]
      },
      "then": {
        "properties": {
          "highAvailability": {
            "properties": {
              "stickyCookie": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
